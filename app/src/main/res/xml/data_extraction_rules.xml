<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude large audio and temporary recordings to prevent exceeding 25 MB quota -->
        <exclude domain="file" path="takes/" />
        <exclude domain="file" path="tmp/" />
        <exclude domain="file" path="exports/" />
    </cloud-backup>
    <device-transfer>
        <!-- Device-to-device transfers preserve all user takes -->
        <include domain="file" path="takes/" />
    </device-transfer>
</data-extraction-rules>
